<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Empty paths use package discovery and the project-local output directory. -->
    <appSettings>
        <add key="BackendRoot" value=""/>
        <!-- A bare executable name is resolved from PATH. The setup script changes
             this to the package-local virtual environment after installation. -->
        <add key="PythonExecutable" value="python.exe"/>
        <add key="RuntimeRoot" value=""/>
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
