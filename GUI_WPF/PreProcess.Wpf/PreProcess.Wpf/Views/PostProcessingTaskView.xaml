<UserControl x:Class="PreProcess.Wpf.Views.PostProcessingTaskView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="后处理任务" FontSize="24" FontWeight="SemiBold"/>
  <TextBlock Grid.Row="1" Text="仅显示已生成的正向、AI、轨迹及其他结果；未产生结果时不提供打开入口。" Foreground="#64748B" Margin="0,8,0,8" TextWrapping="Wrap"/>
  <WrapPanel Grid.Row="2" Margin="0,0,0,8">
   <Border Background="#EEF6FF" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding ForwardCount, StringFormat=正向 {0}}" Foreground="#245A85"/></Border>
   <Border Background="#F1F8F3" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding PredictionCount, StringFormat=AI {0}}" Foreground="#24724A"/></Border>
   <Border Background="#FFF7E8" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding TrajectoryCount, StringFormat=轨迹 {0}}" Foreground="#8A5A00"/></Border>
   <Border Background="#F4F0FF" CornerRadius="4" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding SimilarityCount, StringFormat=相似度 {0}}" Foreground="#5B43A5"/></Border>
   <Border Background="#FDEFF3" CornerRadius="4" Padding="10,5"><TextBlock Text="{Binding SceneCount, StringFormat=场景 {0}}" Foreground="#9A3E5A"/></Border>
  </WrapPanel>
  <DockPanel Grid.Row="3" Margin="0,8,0,0">
   <Button DockPanel.Dock="Top" Content="打开选中结果" Command="{Binding OpenSelectedResultCommand}" IsEnabled="{Binding CanOpenSelectedResult}" HorizontalAlignment="Left" Padding="14,7" Margin="0,0,0,10"/>
   <Border BorderBrush="#D4DDE8" BorderThickness="1" Background="#FFFFFF" Padding="4">
   <ListView ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0">
    <ListView.View><GridView>
     <GridViewColumn Header="结果" DisplayMemberBinding="{Binding DisplayTitle}" Width="190"/>
     <GridViewColumn Header="状态" DisplayMemberBinding="{Binding Availability}" Width="110"/>
     <GridViewColumn Header="运行编号" DisplayMemberBinding="{Binding RunId}" Width="150"/>
     <GridViewColumn Header="提示" DisplayMemberBinding="{Binding AvailabilityMessage}" Width="520"/>
    </GridView></ListView.View>
   </ListView>
   </Border>
  </DockPanel>
 </Grid>
</UserControl>
