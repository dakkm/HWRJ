<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#243449"/><Setter Property="Background" Value="#E8EDF4"/></Style>
 <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D4DDE8"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="PanelTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="12,10"/><Setter Property="FontSize" Value="14"/></Style>
 <Style x:Key="EmptyText" TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Setter Property="Margin" Value="18"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="TabItem"><Setter Property="Padding" Value="12,6"/></Style>
 <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="Padding" Value="5,6"/></Style>
 <Style TargetType="GridSplitter"><Setter Property="Background" Value="#E8EDF4"/><Setter Property="ShowsPreview" Value="True"/><Setter Property="Focusable" Value="True"/></Style>
<Style TargetType="TextBox"><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers></Style></ResourceDictionary>
