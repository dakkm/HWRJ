<UserControl x:Class="PreProcess.Wpf.Views.ModuleExecutionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <StackPanel Margin="18">
  <TextBlock Text="{Binding ModuleTitle}" FontSize="24" FontWeight="SemiBold"/>
  <StackPanel IsEnabled="{Binding CanEdit}">
   <TextBlock Text="请确认当前任务参数后运行所选模块。运行期间任务参数将暂时锁定。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8"/>
   <StackPanel Visibility="{Binding IsForward, Converter={StaticResource Visible}}">
    <TextBlock Text="根据当前任务执行正向计算和特征提取，输出温度、红外响应、目标轨迹及响应特征。选择“仅准备输入”时只生成输入文件，不启动计算。" TextWrapping="Wrap" Margin="0,8"/>
    <CheckBox Content="仅准备输入（不执行求解）" IsChecked="{Binding PrepareOnly}" Margin="0,8"/>
   </StackPanel>
   <StackPanel Visibility="{Binding IsTrajectory, Converter={StaticResource Visible}}">
    <TextBlock Text="读取当前任务最近一次成功正向计算的轨迹数据，生成轨迹指标、三维轨迹图和目标到探测器距离曲线，不会重新执行正向计算或特征提取。" TextWrapping="Wrap" Margin="0,8"/>
    <CheckBox Content="统计中包含释放前、仍与载体连接的轨迹样本" IsChecked="{Binding TrajectoryIncludePrerelease}" Margin="0,8"/>
   </StackPanel>
   <StackPanel Visibility="{Binding IsPrediction, Converter={StaticResource Visible}}">
    <TextBlock Text="智能预测使用模型适用域内的默认模板作为首次任务输入；后续运行保留当前任务输入并检查模型适用域。超出适用域时仅提示，不自动替换场景。温度和红外点图像均由02代理模型生成，计算时间读取场景任务中的仿真时间（最大 1000 s）。" TextWrapping="Wrap" Margin="0,8"/>
   </StackPanel>
   <StackPanel Visibility="{Binding IsSimilarity, Converter={StaticResource Visible}}">
    <TextBlock Text="请选择参考结果和候选结果目录。支持01正向计算输出，也支持02智能预测输出；智能预测目录需包含温度预测和点图像预测文件。" TextWrapping="Wrap" Margin="0,8"/>
    <TextBlock Text="参考正向结果目录"/>
    <Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding ReferenceDirectory, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
     <Button Grid.Column="1" Content="选择文件夹…" Command="{Binding SelectReferenceDirectoryCommand}" Padding="10,4" Margin="6,0,0,0"/>
    </Grid>
    <TextBlock Text="候选正向结果目录"/>
    <Grid Margin="0,3,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox Text="{Binding CandidateDirectory, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"/>
     <Button Grid.Column="1" Content="选择文件夹…" Command="{Binding SelectCandidateDirectoryCommand}" Padding="10,4" Margin="6,0,0,0"/>
    </Grid>
    <TextBlock Text="评价参数使用系统默认配置，结果将以相似度形式显示。" Foreground="#64748B" Margin="0,2,0,0"/>
   </StackPanel>
   <StackPanel Visibility="{Binding IsScene, Converter={StaticResource Visible}}">
    <TextBlock Text="根据当前任务搜索符合条件的红外场景，并依次完成智能预测、正向复核和相似度评价。构建时间读取场景任务中的仿真时间（最大 1000 s），验收阈值读取目标参数页面中的相似度设置；运行过程会启动实际计算。" TextWrapping="Wrap" Margin="0,8"/>
    <TextBlock Text="所需候选数量"/><TextBox Text="{Binding RequiredCandidates, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
   </StackPanel>
  </StackPanel>
  <StackPanel Orientation="Horizontal"><Button Content="运行本模块" Command="{Binding RunCommand}" Padding="12,6" Margin="0,8,12,8"/><Button Content="停止" Command="{Binding StopCommand}" Padding="12,6" Margin="0,8,12,8"/></StackPanel>
  <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12"/>
  <TextBlock Text="本次运行位置" FontWeight="SemiBold"/>
  <TextBox Text="{Binding ResultLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/>
  <TextBlock Text="运行状态、日志和警告会在窗口底部实时更新。" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>
