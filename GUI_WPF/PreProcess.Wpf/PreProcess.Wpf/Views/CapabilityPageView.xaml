<UserControl x:Class="PreProcess.Wpf.Views.CapabilityPageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24">
   <Grid Margin="0,0,0,24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#64748B" VerticalAlignment="Center" Margin="12,0,0,0"/>
   </Grid>
   <ItemsControl ItemsSource="{Binding Parameters}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,0,0,18">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" MinHeight="34"/>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,6,0,0">
    <WrapPanel>
     <Button Content="保存配置" Command="{Binding SaveDraftCommand}" Padding="20,8" Margin="0,0,10,8"/>
     <Button Content="打开配置" Command="{Binding OpenDraftCommand}" Padding="20,8" Margin="0,0,0,8"/>
    </WrapPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
