<UserControl x:Class="PreProcess.Wpf.Views.ModelBoundaryConfigView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="22">
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="模型配置" FontSize="17" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal">
      <Button Content="导出配置" Command="{Binding ExportConfigCommand}" Padding="12,4"/>
      <Button Content="导入配置" Command="{Binding ImportConfigCommand}" Padding="12,4" Margin="8,0,0,0"/>
      <Button Content="检查当前配置" Command="{Binding ValidateConfigCommand}" Padding="12,4" Margin="8,0,0,0"/>
      <Button Content="应用导入配置" Command="{Binding ApplyImportedConfigCommand}" IsEnabled="{Binding HasPendingConfig}" Padding="12,4" Margin="8,0,0,0"/>
     </StackPanel>
     <TextBlock Text="{Binding ConfigStatus}" Margin="0,8,0,0" Foreground="#24724A" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding ImportedConfigPreview}" Margin="0,6,0,0" Foreground="#475569" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <TextBlock Text="模型导入与光热物性、边界信息配置" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="模型信息" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="模型导入" Margin="0,10,0,2" FontWeight="SemiBold"/>
     <Button Content="选择并检查模型文件" Command="{Binding SelectModelCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding ModelFileStatus}" Foreground="#475569" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="光热物性" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding MaterialSummary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <Grid Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="密度 (kg/m³)"/><TextBox Grid.Column="1" Text="{Binding Editor.Task.Targets.Uniform.Density, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Column="2" Text="热容 (J/kg·K)" Margin="8,0,0,0"/><TextBox Grid.Column="3" Text="{Binding Editor.Task.Targets.Uniform.HeatCapacity, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="1" Text="发射率"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Editor.Task.Targets.Uniform.Emissivity, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="太阳吸收率" Margin="8,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Editor.Task.Targets.Uniform.SolarAbsorption, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
     </Grid>
    </StackPanel>
   </Border>
   <Border BorderBrush="#B9D7F0" Background="#F5FAFF" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="网格预览" FontSize="17" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="径向层数" VerticalAlignment="Center"/>
      <TextBox Text="{Binding RadialLayers, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="10,0,12,0"/>
      <Button Content="生成独立网格" Command="{Binding GenerateMeshCommand}" Padding="12,4"/>
      <Button Content="保存网格包" Command="{Binding SaveMeshCommand}" Padding="12,4" Margin="8,0,0,0"/>
      <Button Content="打开网格包" Command="{Binding OpenMeshCommand}" Padding="12,4" Margin="8,0,0,0"/>
      <Button Content="运行三组预览回归" Command="{Binding RunMeshRegressionCommand}" Padding="12,4" Margin="8,0,0,0"/>
     </StackPanel>
     <TextBlock Text="{Binding MeshStatus}" Margin="0,10,0,2" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding MeshGeometrySummary}" Foreground="#475569" Margin="0,2,0,0"/>
     <TextBlock Text="{Binding MeshSummary}" Foreground="#475569" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding MeshIssues}" Foreground="#7C3AED" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding MeshSurfacePreview}" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding MeshRegressionSummary}" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="14">
    <StackPanel>
     <TextBlock Text="边界信息" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="当前边界字段独立保存，避免与环境与观测页面重复写入任务数据。" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
     <TextBlock Text="表面边界类型" FontWeight="SemiBold" Margin="0,10,0,2"/>
     <ComboBox ItemsSource="{Binding BoundaryTypes}" SelectedItem="{Binding SurfaceBoundaryType, UpdateSourceTrigger=PropertyChanged}" Width="280" HorizontalAlignment="Left"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
