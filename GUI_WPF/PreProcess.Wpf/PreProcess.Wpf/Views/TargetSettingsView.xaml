<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PreProcess.Wpf.Views.TargetSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PreProcess.Wpf.Views">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18">
      <TextBlock Text="目标参数" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="统一设置应用到所有未启用独立物性的目标。质量由目标类型、外半径、壳厚和密度计算。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8" />
      <GroupBox Header="弹头相似度等级" Margin="0,10,0,0" Padding="10" IsEnabled="{Binding Editor.Execution.CanEdit}">
        <StackPanel>
          <TextBlock Text="相似度（%）" />
          <TextBox x:Name="SimilarityTextBox" Padding="6" Margin="0,4,0,0" KeyDown="SimilarityTextBox_KeyDown" AutomationProperties.Name="弹头相似度等级 (%)">
            <TextBox.Text>
              <Binding Path="Editor.Task.Settings.SimilarityIndex" Mode="TwoWay" UpdateSourceTrigger="LostFocus">
                <Binding.ValidationRules>
                  <views:SimilarityPercentageValidationRule />
                </Binding.ValidationRules>
              </Binding>
            </TextBox.Text>
          </TextBox>
          <TextBlock Text="允许范围：50%～100%；默认值为90%。该值同时写入正向计算输入，并用于红外场景构建的候选结果验收。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,4" />
        </StackPanel>
      </GroupBox>
      <GroupBox Header="统一设置" Margin="0,10,0,0" Padding="10">
        <StackPanel>
          <views:TargetPhysicsEditor DataContext="{Binding Editor.Task.Targets.Uniform}" />
        </StackPanel>
      </GroupBox>
      <Expander Header="高级单目标设置" Margin="0,14">
        <StackPanel Margin="8">
          <TextBlock Text="目标编号" />
          <ComboBox ItemsSource="{Binding Editor.Task.IndividualTargets}" SelectedItem="{Binding Editor.SelectedTarget}" DisplayMemberPath="DisplayName" Margin="0,6" AutomationProperties.Name="目标编号" />
          <CheckBox Content="启用独立结构与物性覆盖" IsChecked="{Binding Editor.SelectedTarget.UseOverride}" Margin="0,8" />
          <TextBlock Text="首次启用时复制统一几何和物性参数，之后独立编辑。关闭覆盖恢复继承，重新启用保留上次独立值。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8" />
          <views:TargetPhysicsEditor DataContext="{Binding Editor.SelectedTarget.EffectivePhysics}" IsEnabled="{Binding Editor.SelectedTarget.UseOverride}" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
