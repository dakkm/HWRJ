<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PreProcess.Wpf.Views.Vector3Editor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UniformGrid Columns="3">
    <StackPanel Margin="0,4,6,0">
      <TextBlock Text="X" />
      <TextBox Padding="5" MinWidth="35" Text="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="X 分量" />
    </StackPanel>
    <StackPanel Margin="0,4,6,0">
      <TextBlock Text="Y" />
      <TextBox Padding="5" MinWidth="35" Text="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Y 分量" />
    </StackPanel>
    <StackPanel Margin="0,4,6,0">
      <TextBlock Text="Z" />
      <TextBox Padding="5" MinWidth="35" Text="{Binding Z, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Z 分量" />
    </StackPanel>
  </UniformGrid>
</UserControl>