<UserControl x:Class="PreProcess.Wpf.Views.ForwardStageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="22">
   <TextBlock Text="{Binding StageTitle}" FontSize="24" FontWeight="SemiBold"/>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="运行状态" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Status}" FontSize="20" Foreground="#245A85" Margin="0,12,0,0"/>
     <ProgressBar Height="16" Margin="0,12,0,0" IsIndeterminate="{Binding IsBusy}"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="16">
    <StackPanel>
     <TextBlock Text="运行上下文" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="当前运行目录" FontWeight="SemiBold" Margin="0,12,0,2"/>
     <TextBlock Text="{Binding ResultLocation}" Foreground="#64748B" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,12,0,0">
    <StackPanel>
     <TextBlock Text="结果时间轴" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding TimelineSummary}" Foreground="#475569" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
