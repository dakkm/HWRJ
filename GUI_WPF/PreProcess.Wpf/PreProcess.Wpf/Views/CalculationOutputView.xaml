<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PreProcess.Wpf.Views.CalculationOutputView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="18">
      <TextBlock Text="计算与输出" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="设置各功能模块共用的计算参数，并生成当前任务的请求文件。" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8" />
      <GroupBox Header="生成任务请求" Padding="10" Margin="0,8" IsEnabled="{Binding Editor.Execution.CanEdit}">
        <StackPanel>
          <TextBlock Text="正向计算与智能预测共享同一份任务请求。预测与场景搜索仍受后端固定场景限制；生成成功不代表满足预测适用条件。相似度评估使用结果文件。" TextWrapping="Wrap" />
          <TextBlock Text="生成内容使用各页面已接受的有效输入；无效输入不会写入任务。" TextWrapping="Wrap" />
          <Button Content="生成 request.json…" Click="GenerateRequest_Click" HorizontalAlignment="Left" Padding="12,6" Margin="0,8" />
          <TextBlock x:Name="RequestStatus" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>
      <GroupBox Header="公共计算参数" Padding="10" Margin="0,8" IsEnabled="{Binding Editor.Execution.CanEdit}">
        <StackPanel>
          <TextBlock Text="场景搜索温度相似度验收阈值（%）" Margin="0,8,0,0" />
          <TextBox Text="{Binding Editor.Task.Settings.SimilarityIndex, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="6" />
          <TextBlock Text="此阈值保留为场景搜索验收条件，不写入正向请求。" TextWrapping="Wrap" />
        </StackPanel>
      </GroupBox>
      <Border Background="#F5F8FC" Padding="12" Margin="0,8,0,0">
        <TextBlock Text="模块专属参数和运行操作请从左侧“功能模块”进入；运行结果请在右侧结果浏览器或“运行管理”中查看。" TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

