<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <!-- Empty settings use package discovery, PATH Python, and LocalApplicationData runtime storage. -->
    <appSettings><add key="BackendRoot" value=""/><add key="PythonExecutable" value=".python-runtime\python.exe"/><add key="RuntimeRoot" value=""/></appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
