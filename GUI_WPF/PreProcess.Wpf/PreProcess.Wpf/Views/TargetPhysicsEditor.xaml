<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PreProcess.Wpf.Views.TargetPhysicsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PreProcess.Wpf.Views">
  <UserControl.Resources>
    <views:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter" />
  </UserControl.Resources>
  <StackPanel>
    <GroupBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="目标结构" Padding="10" Margin="0,6">
<StackPanel><TextBlock Text="球壳（固定5mm）" FontWeight="SemiBold" Margin="0,4,0,8" />
<TextBlock Text="壳厚：5 mm（后端固定）" Margin="0,4" />
<StackPanel Margin="0,5"><TextBlock Text="外半径 (m)" TextWrapping="Wrap" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="外半径 (m)" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" /></StackPanel></StackPanel></GroupBox>
<GroupBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="材料与热物性参数" Padding="10" Margin="0,6"><StackPanel><StackPanel Margin="0,5"><TextBlock Text="密度 (kg/m³)" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Density, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="密度 (kg/m³)" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="比热 (J/(kg·K))" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding HeatCapacity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="比热 (J/(kg·K))" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="初始温度 (K)" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding InitialTemperature, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="初始温度 (K)" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="内部热源功率 (W)" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding InternalPower, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="内部热源功率 (W)" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="红外发射率" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Emissivity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="红外发射率" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="太阳吸收率" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding SolarAbsorption, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="太阳吸收率" /></StackPanel><StackPanel Margin="0,5"><TextBlock Text="红外反射率" TextWrapping="Wrap" /><TextBox Margin="0,4,0,0" Padding="6" Text="{Binding IrReflection, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource FlexibleDoubleConverter}, ValidatesOnExceptions=True}" AutomationProperties.Name="红外反射率" /></StackPanel></StackPanel></GroupBox>
<GroupBox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Header="质量信息" Padding="10" Margin="0,6"><StackPanel>
<TextBlock Text="自动计算质量 (kg)" />
<TextBlock Text="{Binding Mass, StringFormat={}{0:G8}}" FontWeight="SemiBold" FontSize="18" Margin="0,6" AutomationProperties.Name="自动计算质量" />
<TextBlock Text="球壳质量 = 4π/3 × [外半径³ − (外半径 − 壳厚)³] × 密度。壳厚先由 mm 换算为 m；质量仅为显示信息，不写入请求。" TextWrapping="Wrap" Foreground="#64748B" />
</StackPanel></GroupBox></StackPanel>
</UserControl>
