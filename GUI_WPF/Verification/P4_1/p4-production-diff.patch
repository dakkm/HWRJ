diff --git "a/D:\\Pre-process\\GUI_WPF\\PreProcess.Wpf\\PreProcess.Wpf\\Services\\Process\\ProcessManager.cs" "b/D:\\Pre-process\\GUI_WPF\\PreProcess.Wpf\\PreProcess.Wpf\\Services\\Process\\ProcessManager.cs"
