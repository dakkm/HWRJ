+    <TextBlock Text="Evaluation config 路径（留空使用后端默认）"/><TextBox Text="{Binding EvaluationConfig, UpdateSourceTrigger=PropertyChanged}"/>
+   </StackPanel>
+   <StackPanel Visibility="{Binding IsScene, Converter={StaticResource Visible}}">
