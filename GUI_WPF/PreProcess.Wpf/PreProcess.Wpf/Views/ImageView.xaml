<UserControl x:Class="PreProcess.Wpf.Views.ImageView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#64748B"/></StackPanel>
  <Border Grid.Row="1" Background="Black" BorderBrush="#D4DDE8" BorderThickness="1">
   <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
  </Border>
  <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="{Binding MinimumLabel}" Margin="0,0,8,0"/>
   <Rectangle Grid.Column="1" Height="12"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#000050" Offset="0"/><GradientStop Color="#00B4FF" Offset="0.25"/><GradientStop Color="#00FF00" Offset="0.5"/><GradientStop Color="#FFFF00" Offset="0.75"/><GradientStop Color="#FF0000" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <TextBlock Grid.Column="2" Text="{Binding MaximumLabel}" Margin="8,0,0,0"/>
  </Grid>
 </Grid>
</UserControl>
