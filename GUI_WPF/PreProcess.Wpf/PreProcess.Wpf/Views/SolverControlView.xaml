<UserControl x:Class="PreProcess.Wpf.Views.SolverControlView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="22">
   <TextBlock Text="求解定义与控制" FontSize="24" FontWeight="SemiBold"/>
   <Border BorderBrush="#D8E2EE" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="已有求解定义" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="当前仿真时长" FontWeight="SemiBold" Margin="0,8,0,0"/>
     <TextBlock Text="{Binding DurationSummary}" Margin="0,4,0,0"/>
    </StackPanel>
   </Border>
   <Border BorderBrush="#B9D7F0" Background="#F5FAFF" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,12">
    <StackPanel>
     <TextBlock Text="控制参数" FontSize="17" FontWeight="SemiBold"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/><ColumnDefinition Width="150"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="时间步长 (s)"/><TextBox Grid.Column="1" Text="{Binding TimeStep, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Column="2" Text="输出频率 (s)" Margin="12,0,0,0"/><TextBox Grid.Column="3" Text="{Binding OutputInterval, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="1" Text="收敛阈值"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConvergenceTolerance, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Text="最大迭代次数" Margin="12,0,0,0"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="2" Text="超时 (s)"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Text="求解器选项" Margin="12,0,0,0"/><TextBox Grid.Row="2" Grid.Column="3" Text="{Binding SolverOption, UpdateSourceTrigger=PropertyChanged}" Margin="4"/>
     </Grid>
     <Button Content="检查求解控制" Command="{Binding ValidateControlCommand}" HorizontalAlignment="Left" Padding="12,4" Margin="0,8,0,0"/>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="保存控制配置" Command="{Binding SaveControlCommand}" Padding="12,4"/>
      <Button Content="打开控制配置" Command="{Binding OpenControlCommand}" Padding="12,4" Margin="8,0,0,0"/>
     </StackPanel>
     <TextBlock Text="{Binding ControlStatus}" Foreground="#24724A" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
