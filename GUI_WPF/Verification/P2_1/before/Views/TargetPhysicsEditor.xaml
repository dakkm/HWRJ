<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PreProcess.Wpf.Views.TargetPhysicsEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:PreProcess.Wpf.Views">
  <StackPanel>
    <TextBlock Text="物性参数" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
    <StackPanel Margin="0,5">
      <TextBlock Text="球体半径 (m)" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Radius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="球体半径 (m)" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="密度 (kg/m³)" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Density, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="密度 (kg/m³)" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="比热 (J/(kg·K))" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding HeatCapacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="比热 (J/(kg·K))" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="初始温度 (K)" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding InitialTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="初始温度 (K)" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="内部热源功率 (W)" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding InternalPower, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="内部热源功率 (W)" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="红外发射率" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding Emissivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="红外发射率" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="太阳吸收率" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding SolarAbsorption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="太阳吸收率" />
    </StackPanel>
    <StackPanel Margin="0,5">
      <TextBlock Text="红外反射率" TextWrapping="Wrap" />
      <TextBox Margin="0,4,0,0" Padding="6" Text="{Binding IrReflection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="红外反射率" />
    </StackPanel>
    <StackPanel Margin="0,8">
      <TextBlock Text="球体质量 (kg，按半径和密度计算)" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Mass, StringFormat={}{0:G6}}" Margin="0,5" />
    </StackPanel>
  </StackPanel>
</UserControl>